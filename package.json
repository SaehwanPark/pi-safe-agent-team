{
  "name": "pi-safe-agents-team",
  "version": "0.1.0",
  "description": "Deterministic local coordination for recursive Pi agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "pi-package",
    "pi",
    "subagents",
    "agents",
    "coordination"
  ],
  "license": "MIT",
  "engines": { "node": ">=22.19.0" },
  "repository": {
    "type": "git",
    "url": "https://github.com/SaehwanPark/pi-safe-agent-team"
  },
  "files": [
    "index.ts",
    "src/",
    "dist/",
    "docs/",
    "examples/",
    "README.md",
    "ARCHITECTURE.md",
    "PROTOCOL.md",
    "ROADMAP.md",
    "PRIOR_ART.md",
    "CHANGELOG.md",
    "tsconfig.json"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test",
    "example:core": "node --experimental-strip-types examples/core-demo.ts",
    "example:broker": "node --experimental-strip-types examples/broker-demo.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.85.0",
    "@earendil-works/pi-ai": ">=0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.85.0",
    "@earendil-works/pi-tui": ">=0.85.0"
  },
  "dependencies": {
    "@earendil-works/pi-server": "^0.85.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.85.0",
    "@earendil-works/pi-ai": "^0.85.0",
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "@earendil-works/pi-tui": "^0.85.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
